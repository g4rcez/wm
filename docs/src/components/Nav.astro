---
const path = Astro.url.pathname;
const links = [
  { href: "/docs/overview", label: "Docs", match: "/docs" },
  { href: "/docs/examples", label: "Examples", match: "/docs/examples", hideOnPhone: true },
];
---

<header class="nav-wrap">
  <nav class="nav" aria-label="Main">
    <a class="brand" href="/" aria-label="wm home">
      <img src="/favicon.svg" width="26" height="26" alt="" />
      <span>wm</span>
    </a>
    <ul>
      {
        links.map((l) => (
          <li class:list={[{ "phone-hide": l.hideOnPhone }]}>
            <a href={l.href} aria-current={path.startsWith(l.match) && (l.match !== "/docs" || !path.startsWith("/docs/examples")) ? "page" : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <a class="gh" href="https://github.com/g4rcez/wm" rel="noopener">GitHub</a>
      </li>
    </ul>
    <a class="btn btn-primary cta" href="/docs/install">Install</a>
  </nav>
</header>

<style>
  .nav-wrap {
    position: fixed;
    inset: 12px 0 auto 0;
    z-index: 50;
    padding-inline: var(--gutter);
    pointer-events: none;
  }
  .nav {
    pointer-events: auto;
    max-width: 880px;
    margin-inline: auto;
    height: 52px;
    padding: 0 8px 0 16px;
    display: flex;
    align-items: center;
    gap: 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    box-shadow: 0 8px 30px -12px rgb(0 0 0 / 0.5);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.02em;
  }
  .brand:hover {
    text-decoration: none;
  }
  ul {
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  li a {
    display: block;
    padding: 6px 12px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 14.5px;
    font-weight: 500;
  }
  li a:hover,
  li a[aria-current="page"] {
    color: var(--text);
    background: var(--surface-2);
    text-decoration: none;
  }
  .cta {
    height: 38px;
    padding: 0 16px;
    font-size: 14px;
  }
  @media (max-width: 520px) {
    .phone-hide {
      display: none;
    }
    .nav {
      gap: 8px;
    }
  }
</style>
