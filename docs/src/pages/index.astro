---
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import Demo from "../components/Demo.astro";
import CopyCommand from "../components/CopyCommand.astro";
import CodeTabs from "../components/CodeTabs.astro";
import HeroMosaic from "../components/HeroMosaic.astro";

const install = "git clone https://github.com/g4rcez/wm.git && cd wm && ./build-app.sh";

const facts = ["macOS 14 or later", "Runs with SIP on", "Configured in Lua", "MIT license"];
const layouts = ["Scrolling", "Tiling", "Master-stack", "Tile templates", "Rotate"];

const features = [
  {
    title: "Scrolling and tiling",
    text: "Scrolling puts windows in columns on a strip that moves sideways, as niri and PaperWM do. Tiling splits the screen in a tree, as Hyprland's dwindle layout does. You choose the layout per workspace and change it while wm runs.",
    code: "wm layout set scrolling",
    href: "/docs/scrolling",
    span: 7,
  },
  {
    title: "Emulated workspaces",
    text: "wm hides the windows of other workspaces, so it needs no macOS desktops. Name them as you like, and show them on any monitor.",
    code: "wm workspace web",
    href: "/docs/overview",
    span: 5,
  },
  {
    title: "Binding modes",
    text: "A mode is a separate set of keys. A panel lists the keys that you can press.",
    code: "wm mode resize",
    href: "/docs/key-panel",
    span: 4,
  },
  {
    title: "One command set",
    text: "The wm CLI, Lua and wm:// URLs run the same commands.",
    code: 'wm.dispatch("focus left")',
    href: "/docs/cli",
    span: 4,
  },
  {
    title: "Switcher and overview",
    text: "A switcher with a picture of each window, and an overview of the workspaces.",
    code: 'wm.bind("alt-tab", "switcher")',
    href: "/docs/switcher",
    span: 4,
  },
  {
    title: "Command palette",
    text: "One panel to find windows, apps, browser tabs, wm commands and menu items.",
    code: 'wm.bind("alt-p", "palette")',
    href: "/docs/palette",
    span: 5,
  },
  {
    title: "Hints and scroll mode",
    text: "Click and scroll from the keyboard, as in Homerow.",
    code: 'wm.bind("cmd-shift-space", "hints")',
    href: "/docs/hints",
    span: 7,
  },
  {
    title: "Window rules",
    text: "Match new windows by app or title. Decide where they go and how they look.",
    code: 'wm.rule { app = "com.spotify.client", workspace = "9" }',
    href: "/docs/rules",
    span: 6,
  },
  {
    title: "Special workspaces",
    text: "A scratchpad. One key shows it, the same key hides it.",
    code: "wm workspace special term",
    href: "/docs/special-workspaces",
    span: 6,
  },
];

const tabs = [
  {
    id: "start",
    label: "First config",
    note: "Gaps, a border, vim keys for focus and workspaces. wm reloads the file when you save it.",
    lang: "lua",
    code: `wm.config {
  layout = "tiling",
  gaps = { inner = 8, outer = 8 },
  border = { enabled = true, width = 2, active = "#89b4fa" },
}

-- Focus and move with vim keys
wm.bind("alt-h", "focus left --wrap")
wm.bind("alt-j", "focus down --wrap")
wm.bind("alt-k", "focus up --wrap")
wm.bind("alt-l", "focus right --wrap")
wm.bind("alt-shift-h", "swap left")
wm.bind("alt-shift-l", "swap right")

-- alt-N shows workspace N, alt-shift-N sends the window there
for n = 1, 9 do
  wm.bind("alt-" .. n, "workspace " .. n)
  wm.bind("alt-shift-" .. n, "window send workspace " .. n)
end

wm.bind("alt-f", "window fullscreen")
wm.bind("alt-space", "window float")
wm.bind("alt-s", "layout set scrolling")
wm.bind("alt-t", "layout set tiling")
wm.bind("alt-shift-c", "daemon reload")`,
  },
  {
    id: "modes",
    label: "Modes",
    note: "A resize mode. While it is active, a panel lists its keys with the text from description.",
    lang: "lua",
    code: `wm.mode("resize", {
  h = { "resize width +50", description = "Wider" },
  l = { "resize width -50", description = "Narrower" },
  j = { "resize height +50", description = "Taller" },
  k = { "resize height -50", description = "Shorter" },
  esc = { "mode main", description = "Exit" },
})
wm.bind("alt-shift-r", "mode resize")`,
  },
  {
    id: "prefix",
    label: "Prefix key",
    note: "After alt-space, wm waits for the next key (or Escape) and shows the keys that can follow.",
    lang: "lua",
    code: `local PREFIX = "alt-space>"
wm.bind(PREFIX .. "h", "focus left")
wm.bind(PREFIX .. "l", "focus right")
wm.bind(PREFIX .. "f", "window fullscreen")
wm.bind(PREFIX .. "tab", "switcher")`,
  },
  {
    id: "rules",
    label: "Rules and workspaces",
    note: "A layout per workspace and per monitor, and rules that place new windows.",
    lang: "lua",
    code: `wm.workspace("1", { layout = "scrolling" })
wm.workspace("2", { layout = "tiling" })
wm.workspace("web", { monitor = 2, default = true, gaps = { inner = 0, outer = 0 }, border = false })
wm.workspace("code", { layout = "scrolling", monitor = "LG", layout_options = { default_width = 0.7 } })

wm.rule { app = "com.apple.systempreferences", float = true }
wm.rule { app = "net.kovidgoyal.kitty", float = true, size = { 0.62, 0.68 }, center = true }
wm.rule { title = "^Picture in Picture$", float = true }
wm.rule { app = "com.spotify.client", workspace = "9" }`,
  },
  {
    id: "events",
    label: "Events",
    note: "React to what happens: a workspace changes, a window opens.",
    lang: "lua",
    code: `wm.on("workspace_changed", function(e) wm.log("now on workspace " .. e.workspace) end)
wm.on("window_open", { app = "com.apple.finder" }, function(e)
  wm.dispatch("window float", { window = e.id })
end)`,
  },
];

const cli = `wm list windows                              # every window, as a table
wm list windows --focused --json             # JSON for scripts
wm pick                                      # click a window, get its rule
wm --window app:com.apple.Notes window close # act on a window by app
wm batch 'workspace 2; layout set tiling'    # stops at the first error
wm set gaps.inner 4                          # until the next reload
wm notify 'build done' --seconds=3           # a message on screen`;

const steps = [
  {
    title: "Build",
    text: "You need macOS 14 and the Swift 6.2 toolchain. The script builds wm.app, signs it and starts it.",
    code: "./build-app.sh",
  },
  {
    title: "Grant Accessibility",
    text: "macOS asks the first time wm starts. Allow it in System Settings > Privacy & Security > Accessibility. wm cannot move windows without it.",
  },
  {
    title: "Write your config",
    text: "Create ~/.config/wm/init.lua. wm has no default keys, so bind your own. See First five minutes.",
    code: "wm daemon reload",
  },
];
---

<Base>
  <div class="hero">
    <HeroMosaic />
    <div class="container">
      <a class="badge" href="/docs/first-five-minutes">
        <span class="dot"></span>
        Swift, Lua, no SIP changes
        <span aria-hidden="true">→</span>
      </a>
      <h1>
        A tiling window manager<br />
        <span class="accent">for macOS.</span>
      </h1>
      <p class="sub">
        Scrolling and tiling layouts, emulated workspaces, binding modes and a config in Lua. One command set for the CLI,
        Lua and URLs.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/docs/install">Get started</a>
        <a class="btn" href="https://github.com/g4rcez/wm" rel="noopener">View on GitHub</a>
      </div>
      <div class="install">
        <CopyCommand command={install} />
      </div>
      <ul class="facts">
        {facts.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </div>

  <section class="container section" id="demo">
    <header class="head">
      <p class="eyebrow">Try it</p>
      <h2>Press the keys. It moves.</h2>
      <p>
        This is a model of wm, not a screen recording. Click the desktop and use the binds from{" "}
        <a href="/docs/first-five-minutes">First five minutes</a>: the same commands that wm runs, as you see below the screen.
      </p>
    </header>
    <Demo />
    <ul class="chips" aria-label="Layouts">
      {layouts.map((l) => <li>{l}</li>)}
    </ul>
  </section>

  <section class="container section" id="features">
    <header class="head">
      <p class="eyebrow">Features</p>
      <h2>What you get</h2>
    </header>
    <div class="grid">
      {
        features.map((f) => (
          <a class="card" href={f.href} style={`--span:${f.span}`}>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
            <code>{f.code}</code>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container section" id="config">
    <header class="head">
      <p class="eyebrow">Configure</p>
      <h2>Your config is a Lua file</h2>
      <p>
        <code>~/.config/wm/init.lua</code> is a real program: loops, functions and <code>require</code> work. For a whole file, see{" "}
        <a href="https://github.com/g4rcez/dotfiles/blob/master/config/wm/init.lua" rel="noopener">the author's configuration</a>,
        or the <a href="/docs/config">config reference</a>.
      </p>
    </header>
    <CodeTabs tabs={tabs} />
  </section>

  <section class="container section split" id="cli">
    <header class="head">
      <p class="eyebrow">Command line</p>
      <h2>Script it from the shell</h2>
      <p>
        Every key bind is a command, and every command works from the <code>wm</code> CLI, from Lua (<code>wm.dispatch</code>)
        and from <code>wm://</code> URLs.
      </p>
      <p><a href="/docs/cli">Read the command line guide →</a></p>
    </header>
    <Code code={cli} lang="sh" themes={{ light: "vitesse-light", dark: "vitesse-dark" }} defaultColor={false} />
  </section>

  <section class="container section" id="install">
    <header class="head">
      <p class="eyebrow">Install</p>
      <h2>Three steps</h2>
      <p>wm has no binary release yet. You build it from source.</p>
    </header>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li>
            <span class="num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            {s.code && <code class="step-code">{s.code}</code>}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container section cta">
    <h2>Tile your Mac.</h2>
    <p>Build it, write ten lines of Lua, and press a key.</p>
    <div class="install">
      <CopyCommand command={install} />
    </div>
    <div class="actions">
      <a class="btn btn-primary" href="/docs/install">Read the install guide</a>
      <a class="btn" href="/docs/overview">How wm thinks</a>
    </div>
  </section>
</Base>

<script>
  import { animate, motionValue } from "motion";

  // The light of the feature grid follows the pointer with a spring and fades in and out.
  const section = document.querySelector<HTMLElement>("#features")!;
  const grid = section.querySelector<HTMLElement>(".grid")!;
  const cards = [...grid.querySelectorAll<HTMLElement>(".card")];
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  const x = motionValue(-999);
  const y = motionValue(-999);
  const on = motionValue(0);
  x.on("change", (v) => grid.style.setProperty("--mx", `${v}px`));
  y.on("change", (v) => grid.style.setProperty("--my", `${v}px`));
  on.on("change", (v) => grid.style.setProperty("--on", String(v)));

  const spring = { type: "spring", stiffness: 110, damping: 24, mass: 0.9 } as const;
  const to = (value: typeof x, target: number, options: object) => animate(value, target, still ? { duration: 0 } : options);

  // Each card needs its own corner, so that all of them draw the one light.
  const measure = () =>
    cards.forEach((card) => {
      card.style.setProperty("--ox", `${card.offsetLeft}px`);
      card.style.setProperty("--oy", `${card.offsetTop}px`);
    });
  measure();
  new ResizeObserver(measure).observe(grid);

  let inside = false;
  section.addEventListener("pointermove", (e) => {
    if (e.pointerType === "touch") return;
    const r = grid.getBoundingClientRect();
    const px = e.clientX - r.left;
    const py = e.clientY - r.top;
    if (!inside) {
      // Start at the pointer, so the light does not fly in from the corner.
      inside = true;
      x.jump(px);
      y.jump(py);
    }
    to(x, px, spring);
    to(y, py, spring);
    to(on, 1, { duration: 0.35, ease: "easeOut" });
  });
  section.addEventListener("pointerleave", () => {
    inside = false;
    to(on, 0, { duration: 0.7, ease: "easeOut" });
  });
</script>

<style>
  .hero {
    position: relative;
    padding: calc(var(--nav-h) + 72px) 0 56px;
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }
  .hero > .container {
    position: relative;
  }
  .hero::after {
    content: "";
    position: absolute;
    left: 50%;
    top: -260px;
    width: 900px;
    height: 620px;
    max-width: 140vw;
    transform: translateX(-50%);
    z-index: -1;
    background: radial-gradient(closest-side, var(--glow), transparent);
    pointer-events: none;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    color: var(--muted);
    font-size: 13.5px;
  }
  .badge:hover {
    color: var(--text);
    border-color: var(--accent);
    text-decoration: none;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }
  h1 {
    margin: 22px auto 0;
    max-width: 16ch;
    font-size: clamp(2.5rem, 7.2vw, 4.9rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    font-weight: 700;
    text-wrap: balance;
  }
  .accent {
    color: var(--accent-text);
  }
  .sub {
    margin: 22px auto 0;
    max-width: 58ch;
    color: var(--muted);
    font-size: clamp(1.02rem, 2vw, 1.2rem);
    text-wrap: balance;
  }
  .actions {
    margin-top: 30px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .install {
    margin: 22px auto 0;
    max-width: 780px;
    text-align: left;
  }
  .facts {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 22px;
    color: var(--muted);
    font-size: 14px;
  }
  .facts li::before {
    content: "";
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 8px;
    vertical-align: middle;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Entrance of the hero only. */
  @media (prefers-reduced-motion: no-preference) {
    .hero .badge,
    .hero h1,
    .hero .sub,
    .hero .actions,
    .hero .install,
    .hero .facts {
      animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .hero h1 {
      animation-delay: 0.06s;
    }
    .hero .sub {
      animation-delay: 0.12s;
    }
    .hero .actions {
      animation-delay: 0.18s;
    }
    .hero .install {
      animation-delay: 0.24s;
    }
    .hero .facts {
      animation-delay: 0.3s;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .section {
    padding-top: 88px;
  }
  /* The shared light of the grid spills past its edges. Keep it from widening the page. */
  #features {
    overflow-x: clip;
  }
  .head {
    max-width: 62ch;
    margin-bottom: 32px;
  }
  .head h2 {
    margin: 6px 0 12px;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }
  .head p {
    margin: 0 0 10px;
    color: var(--muted);
  }
  .head code,
  .head + code {
    font-size: 0.88em;
  }
  .head :not(pre) > code {
    padding: 0.12em 0.4em;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface-2);
  }
  .eyebrow {
    margin: 0;
    color: var(--accent-text);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .chips {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    padding: 4px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--muted);
    font-size: 13.5px;
  }

  /* One light for the whole grid. The script sets --mx and --my (pointer, in grid px), --on (0 to 1), and --ox and
     --oy (the offset of each card), so every card draws the same light from its own corner. */
  .grid {
    --mx: -999px;
    --my: -999px;
    --on: 0;
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 14px;
  }
  .grid::before {
    content: "";
    position: absolute;
    inset: -80px;
    pointer-events: none;
    background: radial-gradient(
      560px circle at calc(var(--mx) + 80px) calc(var(--my) + 80px),
      color-mix(in srgb, var(--accent) calc(var(--on) * 15%), transparent),
      transparent 70%
    );
    filter: blur(24px);
  }
  .card {
    --ox: 0px;
    --oy: 0px;
    --at: calc(var(--mx) - var(--ox)) calc(var(--my) - var(--oy));
    grid-column: span var(--span);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: color-mix(in srgb, var(--surface) 55%, transparent);
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.05);
    color: var(--text);
    transition: border-color 0.25s;
  }
  .card:hover {
    text-decoration: none;
    border-color: var(--border-strong);
  }
  .card > * {
    position: relative;
    z-index: 1;
  }
  /* The light on the glass. */
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(
      380px circle at var(--at),
      color-mix(in srgb, var(--accent) calc(var(--on) * 11%), transparent),
      transparent 70%
    );
  }
  /* The light on the edge. */
  .card::after {
    content: "";
    position: absolute;
    inset: -1px;
    padding: 1px;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(
      300px circle at var(--at),
      color-mix(in srgb, var(--accent) calc(var(--on) * 55%), transparent),
      transparent 70%
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    -webkit-mask-composite: xor;
  }
  .card h3 {
    margin: 0;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    flex: 1;
  }
  .card code {
    margin-top: 8px;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--code-bg) 70%, transparent);
    color: var(--accent-text);
    font-size: 12.5px;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 40px;
    align-items: center;
  }
  .split .head {
    margin: 0;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    counter-reset: step;
  }
  .steps li {
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
  }
  .num {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-bottom: 14px;
    border-radius: 9px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    font-size: 14px;
  }
  .steps h3 {
    margin: 0 0 6px;
    font-size: 1.1rem;
  }
  .steps p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .step-code {
    display: block;
    margin-top: 14px;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--code-bg);
    color: var(--accent-text);
    font-size: 13px;
  }

  .cta {
    text-align: center;
  }
  .cta h2 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.2rem);
    letter-spacing: -0.035em;
  }
  .cta p {
    margin: 10px 0 0;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .card {
      grid-column: span 6;
    }
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .hero {
      padding-top: calc(var(--nav-h) + 40px);
    }
    .card {
      grid-column: 1 / -1;
    }
    .section {
      padding-top: 64px;
    }
  }
</style>
